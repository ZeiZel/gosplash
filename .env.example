# ═════════════════════════════════════════════════════════════════════════════
# gosplash — переменные окружения.
#
#   cp .env.example .env    (или просто `make env` — сделает то же самое)
#
# Значения ниже рассчитаны на локальный запуск: инфраструктура в Docker,
# сервисы на хосте через `go run`. Поэтому везде localhost и ПРОБРОШЕННЫЕ
# наружу порты. Внутри docker-сети адреса другие — kafka:9092, redis:6379,
# minio:9000, pg-catalog:5432. Путаница между этими двумя наборами адресов
# даёт большинство «connection refused» на старте.
#
# Порты в диапазоне 5xxxx выбраны потому, что стандартные 5432/9000/9094
# на машине разработчика обычно уже заняты другими проектами.
#
# Читает всё это pkg/config/config.go — единственное место в коде,
# где вызывается os.Getenv.
# ═════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
# MEDIA — шардированное хранилище
#
# Два независимых сервера, между которыми Go-код раскидывает пользователей:
# shard = fnv32(user_id) % количество_шардов.
#
# ПОРЯДОК СТРОК ЗНАЧИМ: индекс в имени переменной — это и есть номер шарда.
# Поменяешь местами — половина картинок «потеряется», потому что хэш будет
# указывать на другой сервер.
#
# Добавить третий шард — дописать MEDIA_SHARD_2_DSN. Код читает переменные
# подряд, пока они есть, менять его не нужно. Но существующие данные при этом
# НЕ переедут: hash % 3 отличается от hash % 2 почти для всех ключей.
# ─────────────────────────────────────────────────────────────────────────────
MEDIA_SHARD_0_DSN=host=localhost port=55432 user=gosplash password=gosplash dbname=gosplash sslmode=disable
MEDIA_SHARD_1_DSN=host=localhost port=55433 user=gosplash password=gosplash dbname=gosplash sslmode=disable


# ─────────────────────────────────────────────────────────────────────────────
# CATALOG — реплицированное хранилище
#
# Не путать с шардированием выше:
#   шарды    — РАЗНЫЕ данные на разных серверах (лечит запись и объём);
#   реплика  — ТЕ ЖЕ данные на втором сервере (лечит чтение и отказ узла).
#
# Записи (их делает Kafka-консьюмер) идут в primary, чтения (публичный API) —
# в реплику. Разводит запросы плагин GORM dbresolver, в коде репозитория
# это не видно.
#
# Оставь CATALOG_REPLICA_DSN пустым — сервис будет работать на одной базе.
# ─────────────────────────────────────────────────────────────────────────────
CATALOG_DSN=host=localhost port=55434 user=gosplash password=gosplash dbname=gosplash sslmode=disable
CATALOG_REPLICA_DSN=host=localhost port=55438 user=gosplash password=gosplash dbname=gosplash sslmode=disable

# Строка подключения, по которой РЕПЛИКА ходит к primary за потоком изменений.
# Её выполняет сервер реплики внутри docker-сети, поэтому здесь pg-catalog:5432,
# а не localhost:55434. Используется один раз, при CREATE SUBSCRIPTION
# в `make migrate`.
CATALOG_REPLICATION_CONN=host=pg-catalog port=5432 user=gosplash password=gosplash dbname=gosplash


# ─────────────────────────────────────────────────────────────────────────────
# Базы сервисов, до которых очередь ещё не дошла (фаза 3 в docs/PLAN.md)
# ─────────────────────────────────────────────────────────────────────────────
WALLET_DSN=host=localhost port=55435 user=gosplash password=gosplash dbname=gosplash sslmode=disable
ORDER_DSN=host=localhost port=55436 user=gosplash password=gosplash dbname=gosplash sslmode=disable


# ─────────────────────────────────────────────────────────────────────────────
# KAFKA
#
# 59094 — EXTERNAL listener брокера, тот самый, который он анонсирует клиентам
# как localhost. Изнутри docker-сети адрес был бы kafka:9092.
#
# Consumer group — механизм разделения работы: процессы с ОДИНАКОВОЙ группой
# делят партиции между собой, с разными — каждый читает топик целиком.
# Хочешь посмотреть, как сообщения расходятся по двум процессам, — оставь
# группу одинаковой и запусти catalog дважды.
# ─────────────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:59094
KAFKA_CONSUMER_GROUP_CATALOG=catalog
KAFKA_CONSUMER_GROUP_THUMBNAIL=thumbnail-worker


# ─────────────────────────────────────────────────────────────────────────────
# S3 (MinIO)
#
# В базе лежат только метаданные и ключ объекта, байты — здесь.
# Бакет с оригиналами приватный: наружу уходит временная подписанная ссылка,
# живущая S3_PRESIGNED_TTL.
# ─────────────────────────────────────────────────────────────────────────────
S3_ENDPOINT=localhost:59000
S3_ACCESS_KEY=gosplash
S3_SECRET_KEY=gosplash
S3_USE_SSL=false
S3_BUCKET_ORIGINALS=gosplash-originals
S3_BUCKET_THUMBNAILS=gosplash-thumbnails
S3_PRESIGNED_TTL=15m


# ─────────────────────────────────────────────────────────────────────────────
# АДРЕСА СЕРВИСОВ
#
# 81xx — HTTP (наружу, через NGINX), 91xx — gRPC (только между сервисами).
# Эти же порты прописаны в deploy/nginx/gateway.conf.
# ─────────────────────────────────────────────────────────────────────────────
MEDIA_HTTP_ADDR=:8101
MEDIA_GRPC_ADDR=:9101
CATALOG_HTTP_ADDR=:8102
CATALOG_GRPC_ADDR=:9102
WALLET_HTTP_ADDR=:8103
WALLET_GRPC_ADDR=:9103
ORDER_HTTP_ADDR=:8104
ORDER_GRPC_ADDR=:9104

# 82xx — служебный порт: /metrics для Prometheus и /debug/pprof.
# Отдельно от публичного намеренно: наружу его не выставляют, а профилировать
# нужно ровно тогда, когда основной сервер захлёбывается.
# Эти же порты перечислены в deploy/observability/prometheus.yaml.
MEDIA_METRICS_ADDR=:8201
CATALOG_METRICS_ADDR=:8202
THUMBNAIL_METRICS_ADDR=:8203
WALLET_METRICS_ADDR=:8204
ORDER_METRICS_ADDR=:8205

# Куда catalog ходит за подробностями о фото, получив событие из Kafka.
MEDIA_GRPC_TARGET=localhost:9101
CATALOG_GRPC_TARGET=localhost:9102
WALLET_GRPC_TARGET=localhost:9103


# ─────────────────────────────────────────────────────────────────────────────
# НАБЛЮДАЕМОСТЬ
#
# Трейсы уезжают в OTel Collector по OTLP gRPC, оттуда в Tempo.
# Метрики НЕ отправляются никуда: Prometheus сам приходит за ними на /metrics.
# Логи — это stdout в JSON; в docker их подбирает promtail и кладёт в Loki.
#
# Оставь OTEL_EXPORTER_OTLP_ENDPOINT пустым, если коллектор не поднят:
# сервис продолжит работать, просто трейсов не будет.
# ─────────────────────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:54317
OTEL_TRACE_SAMPLE_RATIO=1.0    # локально трассируем всё; в проде это сотые доли
ENVIRONMENT=local
LOG_LEVEL=debug


# ─────────────────────────────────────────────────────────────────────────────
# ЕЩЁ НЕ ИСПОЛЬЗУЕТСЯ — появится на своих фазах (docs/PLAN.md)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:56379          # фаза 2: кэш каталога, лок, rate limit
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_MAX_RETRIES=3
REDIS_DIAL_TIMEOUT=2s
REDIS_READ_TIMEOUT=500ms
CACHE_TTL=10m
CATALOG_VIEW_BATCH_SIZE=200
CATALOG_VIEW_FLUSH_INTERVAL=2s
TEMPORAL_ADDRESS=localhost:57233    # фаза 3: сага на Temporal
TEMPORAL_NAMESPACE=gosplash
TEMPORAL_TASK_QUEUE=order-saga

# ─────────────────────────────────────────────────────────────────────────────
# OUTBOX И КОНСЬЮМЕРЫ (фаза 1)
# ─────────────────────────────────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL=1s      # как часто relay заглядывает в таблицу
OUTBOX_BATCH_SIZE=100        # сколько событий забирать за раз
CONSUMER_MAX_RETRIES=3       # попыток на месте, прежде чем уйти в retry-топик
RETRY_DELAY=30s              # через сколько retry-консьюмер вернётся к сообщению

# Превью: размеры по длинной стороне, WebP.
THUMBNAIL_SIZES=320,800,1600
# Пул воркеров ресайза. Пусто — runtime.NumCPU(). Обработка изображений
# CPU-bound: горутина на сообщение даст тысячу параллельных ресайзов и OOM.
THUMBNAIL_WORKERS=

# ─────────────────────────────────────────────────────────────────────────────
# TEMPORAL (фаза 3)
# ─────────────────────────────────────────────────────────────────────────────
CATALOG_GRPC_ADDR=:9102
WALLET_HTTP_ADDR=:8103
ORDER_HTTP_ADDR=:8104
IDEMPOTENCY_TTL=24h

# ─────────────────────────────────────────────────────────────────────────────
# CLICKHOUSE (фаза 4)
#
# 59440 — native-протокол, им ходит clickhouse-go. 58123 — HTTP, им удобно
# лазить curl'ом и им же пользуется Kafka engine внутри docker-сети.
# ─────────────────────────────────────────────────────────────────────────────
CLICKHOUSE_ADDR=localhost:59440
CLICKHOUSE_DB=gosplash
CLICKHOUSE_USER=gosplash
CLICKHOUSE_PASSWORD=gosplash
ANALYTICS_GRPC_ADDR=:9106
ANALYTICS_HTTP_ADDR=:8106
ANALYTICS_METRICS_ADDR=:8206

# ─────────────────────────────────────────────────────────────────────────────
# ELASTICSEARCH (фаза 5)
# ─────────────────────────────────────────────────────────────────────────────
ELASTICSEARCH_ADDRS=http://localhost:59200
SEARCH_INDEX_ALIAS=listings
SEARCH_GRPC_ADDR=:9107
SEARCH_HTTP_ADDR=:8107
SEARCH_METRICS_ADDR=:8207
KAFKA_CONSUMER_GROUP_SEARCH=search
KAFKA_CONSUMER_GROUP_ANALYTICS=analytics
# ─────────────────────────────────────────────────────────────────────────────
# gRPC (фаза 3)
#
# JWT_SECRET пустой — проверка подписи выключена. Локально это удобно, в проде
# недопустимо: сервис пишет об этом предупреждение при старте.
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=
GRPC_DEFAULT_TIMEOUT=5s
# ─────────────────────────────────────────────────────────────────────────────
# ЛИМИТЫ И ВОРКЕРЫ (волна 2)
# ─────────────────────────────────────────────────────────────────────────────
# Token bucket загрузок: 10 подряд, дальше по одной раз в две секунды.
MEDIA_UPLOAD_RATE_CAPACITY=10
MEDIA_UPLOAD_RATE_REFILL_PER_SEC=0.5

THUMBNAIL_HTTP_ADDR=:8105
THUMBNAIL_LOCK_TTL=30s
