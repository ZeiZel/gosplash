# Сборка. `make build`/`make build-linux` кладут всё сюда — единая точка
# для локальных бинарников и для тех, что уходят в Docker-образы
# (deploy/docker/*.Dockerfile копируют готовый файл именно отсюда).
/build/
# `go build ./...` внутри модуля кладёт бинарник рядом с исходниками и
# называет его по имени директории — так в репозиторий и попадают
# случайные 30-мегабайтные артефакты.
/tools/automigrate/automigrate
/tools/mediactl/mediactl
/tools/kafka-reprocess/kafka-reprocess
/tools/search-reindex/search-reindex
/tools/archcheck/archcheck
*.exe
*.test
*.out

# Локальные данные (всё живёт в docker volume, но на всякий случай)
/postgres-data/
/minio-data/
/tmp/

# Локальное окружение. В репозитории живёт .env.example — шаблон со всеми
# переменными и объяснениями; свой .env каждый делает из него (make env).
.env
.env.local
*.pem

# Редакторы
.idea/
.vscode/
.DS_Store

# Одноразовые бинарники ручных проверок
/e2echeck
