# ─────────────────────────────────────────────────────────────────────────────
# media-service — образ для Kubernetes (фаза 6, docs/PLAN.md).
#
# Слушает :8101 (HTTP, публичный), :9101 (gRPC, межсервисный) и :8201
# (служебный — /metrics, /debug/pprof). Порты и .env.example — из
# pkg/config/config.go, единственного места, где проект знает про
# переменные окружения; сам образ ничего не хардкодит, кроме команды
# запуска.
#
# ── НЕОЧЕВИДНОЕ РЕШЕНИЕ: ГОТОВЫЙ БИНАРНИК ИЗ ./build, А НЕ СБОРКА ВНУТРИ ────
#
# Раньше у каждого образа была своя builder-стадия (golang:1.27), которая
# копировала go.work-модули через локальный `replace` (см. историю этого
# файла) и заново гоняла `go mod tidy && go build` ВНУТРИ контейнера. При
# девяти образах (media, catalog, wallet, order, order-worker,
# thumbnail-worker, analytics, search, automigrate) это значит: граф
# зависимостей монорепы (grpc, otel, pgx, gorm, franz-go, ...) компилируется
# ДЕВЯТЬ раз — по разу на образ, — даже когда правка касалась только media.
# BuildKit-кэш модулей смягчал это, но только на ОДНОЙ машине/раннере с
# тёплым кэшем; на чистом раннере CI цена реальна.
#
# Решение — один `go build` СНАРУЖИ (`make build-linux`, см. корневой
# Makefile), и Dockerfile просто копирует готовый файл:
#
#   COPY build/media /usr/local/bin/media
#
# Дальше это plain distroless-образ без builder-стадии вообще — компилировать
# внутри Docker больше нечего.
#
# ЦЕНА: образ перестаёт быть самодостаточным. Раньше `git clone && docker
# build -f deploy/docker/media.Dockerfile .` работал сам по себе — сейчас
# `docker build` находит /out/media... то есть build/media только если ему
# ПРЕДШЕСТВОВАЛ `make build-linux`, а без него сборка образа падает на
# `COPY build/media` с "file not found", и это НЕ баг, а честная граница
# ответственности: Dockerfile больше не знает, как собирать Go, он знает
# только, как упаковать уже собранное. Порядок пайплайна теперь ЖЁСТКО
# двухшаговый (см. mk/k8s.mk, цель k8s-images, и .github/workflows/ci.yml,
# job build): сначала `make build-linux`, потом `docker build`. Выигрыш —
# один `go build` на все девять образов вместо девяти независимых, каждый
# из которых заново качает и компилирует один и тот же граф зависимостей.
# ─────────────────────────────────────────────────────────────────────────────
#
# ── ПОЧЕМУ distroless, А НЕ alpine ──────────────────────────────────────────
#
# Бинарник статический (CGO_ENABLED=0 выставляется в `make build-linux`, а не
# здесь — ни один пакет в pkg/ и services/media не тянет cgo: pgx,
# gorm/postgres и minio-go — чистый Go), поэтому alpine не нужен ради
# musl/glibc-совместимости — единственная причина, по которой alpine обычно
# предпочитают distroless для Go. А раз libc не нужен, то и весь остальной
# набор alpine (shell, apk, busybox-утилиты) — это чистая лишняя поверхность
# атаки: у распечатанного контейнера appspace нет ни одной причины иметь
# /bin/sh, а у атакующего, получившего RCE через уязвимость в приложении, он
# есть, если мы его туда положим. distroless *-nonroot* дополнительно решает
# второе требование задания («никакого root») без отдельного `RUN adduser` —
# пользователь nonroot (UID 65532) уже встроен в базовый образ.
# ─────────────────────────────────────────────────────────────────────────────

FROM gcr.io/distroless/static-debian12:nonroot

# Бинарник уже собран под linux/$(ARCH) снаружи — см. `make build-linux`
# в корневом Makefile и разбор цены в комментарии выше.
COPY build/media /usr/local/bin/media

# nonroot:nonroot (UID/GID 65532) — уже пользователь по умолчанию в базовом
# образе, USER здесь явный, а не подразумеваемый: не полагаемся на то, что
# кто-то не поменяет базовый образ на просто :latest в будущем правками.
USER nonroot:nonroot

ENTRYPOINT ["/usr/local/bin/media"]
