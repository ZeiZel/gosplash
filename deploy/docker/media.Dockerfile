# ─────────────────────────────────────────────────────────────────────────────
# media-service — образ для Kubernetes (фаза 6, docs/PLAN.md).
#
# Слушает :8101 (HTTP, публичный), :9101 (gRPC, межсервисный) и :8201
# (служебный — /metrics, /debug/pprof). Порты и .env.example — из
# pkg/config/config.go, единственного места, где проект знает про
# переменные окружения; сам образ ничего не хардкодит, кроме команды
# запуска.
#
# ── НЕОЧЕВИДНОЕ РЕШЕНИЕ: как собрать МОНОРЕПУ С go.work В ОДИН ОБРАЗ ─────────
#
# go.work в корне репозитория объединяет ВСЕ модули (7 сервисов + 4 tools +
# корневой gosplash) в одно рабочее пространство — это удобно для локальной
# разработки (правишь pkg/dbx, и `go build` в любом сервисе сразу видит
# правку без publish/tag/go.mod bump), но плохая идея для Docker-образа
# ОДНОГО сервиса по двум причинам:
#
#  1. go.work на верхнем уровне ссылается директивой use() на директории ВСЕХ
#     сервисов. Скопируй в контекст сборки только go.work и services/media —
#     и `go build` в workspace-режиме откажется резолвить: он ожидает найти
#     ./services/catalog, ./services/wallet и так далее ФИЗИЧЕСКИ на диске,
#     потому что go.work — это не список "модулей, которые МОГУТ быть нужны",
#     а список "модулей, из которых состоит рабочее пространство".
#  2. Даже если скопировать все 7+4 модуля целиком (это единственный способ
#     заставить go.work работать as-is), любое изменение в ЛЮБОМ сервисе
#     инвалидирует Docker-слой COPY для ВСЕХ образов — сборка media начинает
#     зависеть от того, трогал ли кто-то wallet. Кэш слоёв перестаёт работать
#     ровно там, где он нужнее всего: в CI, который пересобирает 7 образов
#     на каждый пуш.
#
# Решение — НЕ копировать go.work вообще. Вместо workspace используем то,
# что go.work делает "под капотом" для одного модуля: локальный `replace`.
# В контекст сборки идёт ровно два куска: корневой модуль (go.mod, go.sum,
# pkg/, gen/ — общие библиотеки и protobuf-контракты) и директория ОДНОГО
# сервиса. Внутри контейнера `go mod edit` добавляет модулю media фиктивный
# require на "gosplash" (версии-заглушки, потому что он никогда не будет
# резолвиться из прокси) и replace на локальный путь ../.. — ровно туда,
# куда его скопировали. Дальше `go mod tidy` пересобирает граф зависимостей
# уже с локальным gosplash, и `go build` работает как обычно.
#
# ЦЕНА: go.mod корневого модуля объявляет зависимости ДЛЯ ВСЕГО pkg/ разом
# (dbx, kafkax, s3x, outbox, redisx, ...), а не только для того, что нужно
# конкретно media. `go mod tidy` после replace вынужден прочитать граф
# ВСЕГО корневого модуля (включая testcontainers-go, ClickHouse-драйвер
# и прочее, что реально использует только analytics/thumbnail-worker),
# и слой сборки становится тяжелее, чем «дай мне только то, что я импортирую».
# Это не баг решения, а неизбежное следствие ОБЩЕГО go.mod на весь pkg/
# (см. docs/PLAN.md, таблицу «общий файл → как разведён»: pkg/config и
# другие общие пакеты специально держат один go.mod, чтобы не размножать
# версии зависимостей). Смягчается BuildKit-кэшем модулей (--mount=type=cache)
# ниже: полную загрузку граф платит только первая сборка на машине/раннере,
# все следующие переиспользуют кэш, даже когда меняется код сервиса.
#
# Альтернатива «скопировать go.work и ВСЕ модули» была бы проще как рецепт,
# но дороже как процесс (см. пункт 2 выше) — и именно поэтому она отвергнута.
#
# ── ПОЧЕМУ distroless, А НЕ alpine ──────────────────────────────────────────
#
# Бинарник статический (CGO_ENABLED=0 — ни один пакет в pkg/ и services/media
# не тянет cgo: pgx, gorm/postgres и minio-go — чистый Go), поэтому alpine
# не нужен ради musl/glibc-совместимости — единственная причина, по которой
# alpine обычно предпочитают distroless для Go. А раз libc не нужен, то и
# весь остальной набор alpine (shell, apk, busybox-утилиты) — это чистая
# лишняя поверхность атаки: у распечатанного контейнера appspace нет ни
# одной причины иметь /bin/sh, а у атакующего, получившего RCE через
# уязвимость в приложении, он есть, если мы его туда положим. distroless
# *-nonroot* дополнительно решает второе требование задания («никакого
# root») без отдельного `RUN adduser` — пользователь nonroot (UID 65532)
# уже встроен в базовый образ.
# ─────────────────────────────────────────────────────────────────────────────

FROM golang:1.27 AS builder
WORKDIR /src

# Сначала — только то, что редко меняется (корневой модуль), отдельным
# слоем: правка services/media не должна инвалидировать кэш загрузки
# зависимостей общих пакетов.
COPY go.mod go.sum ./
COPY pkg/ ./pkg/
COPY gen/ ./gen/

# Затем — сам сервис.
COPY services/media/ ./services/media/

WORKDIR /src/services/media

# См. разбор выше: версия-заглушка, потому что gosplash никогда не резолвится
# из module-прокси — replace ниже подменяет её на локальный путь до того,
# как go успеет попытаться её куда-то сходить.
RUN go mod edit \
      -require=gosplash@v0.0.0-00010101000000-000000000000 \
      -replace=gosplash=../../

# Кэш-точки BuildKit: модульный кэш и кэш компиляции переживают между
# сборками РАЗНЫХ сервисов на одной машине (общий golang.org/x/... и
# google.golang.org/grpc не перекачиваются на каждый образ заново).
RUN --mount=type=cache,target=/root/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod tidy && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/media ./cmd/media

# ─────────────────────────────────────────────────────────────────────────────
FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder /out/media /usr/local/bin/media

# nonroot:nonroot (UID/GID 65532) — уже пользователь по умолчанию в базовом
# образе, USER здесь явный, а не подразумеваемый: не полагаемся на то, что
# кто-то не поменяет базовый образ на просто :latest в будущем правками.
USER nonroot:nonroot

ENTRYPOINT ["/usr/local/bin/media"]
